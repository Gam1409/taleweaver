flowchart TD
    Start(["Submit player input"]) --> Lease["Authorize session and acquire its mutation lease"]
    Lease --> Load["Load or recover the scoped session and turn context"]
    Load --> Branch{"Current mode and action path"}
    Branch -->|RPG or Story mechanics| Mechanics["Structured mechanics proposal"]
    Branch -->|VN| Progression["Structured VN progression and world resolution"]
    Branch -->|Chat| Chat["Applicable host rules and optional generator tools"]
    Mechanics --> Validate["Validate access, known IDs, possessions and deterministic gates"]
    Progression --> Validate
    Chat --> Validate
    Validate --> Outcomes["Retain accepted outcomes and explicit refusals"]
    Outcomes --> Clock["Advance only the applicable game-clock boundaries or confirmed elapsed time"]
    Clock --> Personality{"NPC Personality mode"}
    Personality -->|Off| Narrator["Build narration with canonical world context"]
    Personality -->|Shadow| Observe["Compute observations without steering narration"]
    Personality -->|Live| Decide["Staged or Integrated decisions; optional scoped tools"]
    Observe --> Narrator
    Decide --> Plans["Apply source, budget and autonomy checks to NPC meaning plans"]
    Plans --> Narrator
    Narrator --> Prose["Generate prose and optional presentation cues"]
    Prose -.-> Stream["Unbuffered narration sends prose chunks before reconciliation and commit"]
    Prose --> Review["Use enabled shared NPC review and bounded recovery policy"]
    Review --> Complete{"Usable completed narration?"}
    Complete -->|Yes, VN| Reconcile["Reconcile source-backed state and optional scene staging"]
    Complete -->|Yes, other mode| Save["Persist reply and canonical turn state"]
    Reconcile --> Save
    Save --> Bind["Bind accepted evidence and capture the selected illustration moment"]
    Bind --> Commit["Commit the completed turn"]
    Commit --> Deferred["Schedule eligible background memory and visuals"]
    Deferred --> Delivery["Release any live CHPM buffered prose, then emit the final receipt"]
    Delivery --> End(["Turn complete"])
    Complete -->|No| Recovery["Preserve or recover state under the existing incomplete/error policy"]
    Recovery --> Reload["Client reconciles saved history before another uncertain action"]
    Branch -.-> Other["Commands, combat and terminal reports can use dedicated early branches"]
