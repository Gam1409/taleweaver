flowchart TD
    Start(["Start generation job"]) --> Lease["Check ownership, cancellation and job revision"]
    Lease --> Prepare["Resolve mode, narrative settings, styles and authored blueprint"]
    Prepare --> Restore["Validate matching input fingerprint and saved staged checkpoints"]
    Restore --> Plan["Reuse a valid plan or plan identifiers and world structure"]
    Plan --> Protagonist["Reuse or generate validated protagonist detail"]
    Protagonist --> Batch["Reuse or generate validated detail batches of up to two entities"]
    Batch --> More{"More required batches?"}
    More -->|Yes| Batch
    More -->|No| Assemble["Assemble the world manifest"]
    Assemble --> Validate["Validate the draft and mode-specific constraints"]
    Validate --> Apply["Apply authored narrative and world data under generation guards"]
    Apply --> Avatar["Persist protagonist baseline and configured portrait"]
    Avatar --> Scenes["Persist scenes, requested backgrounds and directional exits"]
    Scenes --> Npcs["Persist NPC identities, inventories and requested portraits"]
    Npcs --> Items["Persist objects, requested icons and inventory references"]
    Items --> Assets["Finalize asset reuse and generation results"]
    Assets --> Final["Finalize validation and generation status"]
    Final --> End(["Generation complete"])
    Lease -.-> Stop["Cancellation or stale revision prevents further writes"]
    Batch -.-> Retry["Invalid output uses bounded correction; exhausted jobs remain failed or resumable"]
    Validate -.-> Retry
