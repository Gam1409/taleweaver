{
  "format": "TaleWeaver",
  "version": "1.3",
  "adventure": {
    "title": "Choice Test: The Ticking Bomb",
    "teaser": "One minute, two wires, one choice.",
    "cover_appearance": "subway maintenance room, ticking bomb, red and blue wires, harsh lamp",
    "version": "2.0.0",
    "creator": "TaleWeaver Test",
    "language": "English",
    "original_prompt": "Minimal test adventure for script-driven choice dialogs (tw.dialog.choose).",
    "rule_enforcement_mode": "chat",
    "time_per_turn": 1,
    "pacing_minutes": 1,
    "max_memory_turns": 10,
    "clock_enabled": false,
    "generate_scene_images": false,
    "generate_npc_images": false,
    "generate_item_images": false,
    "scripts_generation_enabled": true,
    "plot": "A bomb ticks in an abandoned subway maintenance room. The protagonist must disarm it. Inspecting or tampering with the bomb opens a choice dialog. The maintenance note tells which wire is safe; the wire options only appear once the protagonist carries the wire cutters.",
    "rules": "The bomb is resolved exclusively through the choice dialog opened by scripts. The GM must never decide the bomb's outcome on its own; it only narrates.",
    "intro_text": "A steady ticking echoes through the dark maintenance room. Somewhere in here is a bomb.",
    "completed_condition": "The bomb has been disarmed.",
    "gameover_condition": "The bomb exploded.",
    "completed_guard_expression": "tw.vars.get('bomb_disarmed') == True",
    "gameover_guard_expression": "tw.vars.get('bomb_exploded') == True",
    "can_damage_npcs": false,
    "npcs_can_damage_protagonist": false,
    "allow_dynamic_items": false
  },
  "protagonist": {
    "name": "Sam Ortega",
    "role": "Bomb Squad Rookie",
    "description": "First week on the bomb squad, left alone with a live device.",
    "goal": "Disarm the bomb before it goes off.",
    "character": "Nervous but stubborn.",
    "appearance": "young technician, padded vest, headlamp",
    "hp": 30,
    "max_hp": 30,
    "stamina": 50,
    "max_stamina": 50,
    "mana": 0,
    "max_mana": 0,
    "exp": 0,
    "strength": 10,
    "dexterity": 12,
