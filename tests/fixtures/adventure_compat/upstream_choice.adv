      "special_actions": [],
      "unlocked_actions": []
    },
    "status_effects": [],
    "starting_inventory": [],
    "starting_equipment": {}
  },
  "scenes": [
    {
      "id": "MAINTENANCE_ROOM",
      "label": "Subway Maintenance Room",
      "description": "A cramped concrete room under the subway line. A single caged lamp buzzes overhead. A crude bomb with a digital timer is bolted to the workbench; a red and a blue wire run into its detonator. A toolbox lies open on the floor, and a laminated note is taped to the wall.",
      "decorative_objects": [
        "buzzing caged lamp",
        "rusty pipes",
        "puddle of oily water"
      ]
    }
  ],
  "exits": [],
  "npcs": [],
  "objects": [
    {
      "id": "BOMB",
      "entity_type": "OBJECT",
      "name": "Bomb",
      "description": "A ticking pipe bomb strapped to a cheap digital timer, bolted to the workbench. A red and a blue wire run into the detonator.",
      "appearance": "A ticking pipe bomb strapped to a cheap digital timer, bolted to the workbench. A red and a blue wir",
      "current_scene_id": "MAINTENANCE_ROOM",
      "spatial_position": "bolted to the workbench",
      "item_type": "STATIC",
      "is_hidden": false,
      "is_portable": false,
      "is_in_inventory": false,
      "inventory": []
    },
    {
      "id": "WIRE_CUTTERS",
      "entity_type": "OBJECT",
      "name": "Wire Cutters",
      "description": "Insulated wire cutters with yellow grips.",
      "appearance": "Insulated wire cutters with yellow grips.",
      "current_scene_id": "MAINTENANCE_ROOM",
      "spatial_position": "in the open toolbox on the floor",
      "item_type": "TOOL",
      "is_hidden": false,
      "is_portable": true,
      "is_in_inventory": false,
      "inventory": []
    },
    {
      "id": "MAINTENANCE_NOTE",
      "entity_type": "OBJECT",
      "name": "Laminated Note",
      "description": "A laminated note taped to the wall, scrawled in marker.",
      "appearance": "A laminated note taped to the wall, scrawled in marker.",
      "current_scene_id": "MAINTENANCE_ROOM",
      "spatial_position": "taped to the wall above the workbench",
      "item_type": "READABLE",
      "is_hidden": false,
      "is_portable": true,
      "is_in_inventory": false,
      "inventory": [],
      "text_log_content": "If you are reading this, I ran out of time.\n\nThe blue wire feeds the trigger - cut it and it fires.\nThe red wire is the power line. Cut red. Only red.\n\nAnd take the cutters from the toolbox, rookie. Teeth won't do.",
      "text_log_format": "DOCUMENT"
    }
  ],
  "quests": [],
  "awards": [],
  "sequences": [
    {
      "id": "SEQ_1_DISARM",
      "order": 1,
      "title": "Sixty Seconds",
      "description": "The protagonist must disarm the bomb. Its outcome is decided only by the choice dialog.",
      "walkthrough": "1. Read the laminated note (MAINTENANCE_NOTE): cut the red wire. 2. Take the WIRE_CUTTERS from the toolbox; without them the wire options stay hidden. 3. Inspect, use or tamper with the BOMB (it is bolted down) to open the choice dialog. 4. 'Cut the red wire' -> bomb_disarmed -> victory. 'Cut the blue wire' -> game over. 'Scream like a baby' -> -5 HP. 'Step back and think' closes the dialog. Inspecting the bomb again reopens the dialog.",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "tw.vars.get('bomb_disarmed') == True",
      "exp_reward": 100,
      "on_start_sequence_script": "",
      "on_start_sequence_text": "",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "",
      "soft_rules": [],
      "scripts": [
        {
          "id": "SEQ_BOMB_DIALOG",
          "name": "Bomb opens wire choice",
          "trigger": "on_interact",
          "target_id": "BOMB",
          "code": "if not tw.vars.get('bomb_disarmed', False):\n    tw.dialog.choose(\n        'The timer reads 00:59 and keeps falling. A red and a blue wire run into the detonator. What do you do?',\n        [\n            {'label': 'Cut the red wire', 'visible_if': \"tw.player.has_item('WIRE_CUTTERS')\"},\n            {'label': 'Cut the blue wire', 'visible_if': \"tw.player.has_item('WIRE_CUTTERS')\"},\n            'Scream like a baby',\n            'Step back and think',\n        ],\n        on_choice='on_bomb_wire',\n    )\n",
          "description": "Opens the wire choice whenever the player inspects, uses or tampers with the bomb during this chapter."
        }
      ]
    }
  ],
  "scripts": [],
  "init_script": "def on_bomb_wire(answ):\n    if answ == 0:\n        tw.vars.set('bomb_disarmed', True)\n        tw.narrate('Snip. The red wire parts, the display flickers and dies. You disarmed the trap.')\n        return\n    if answ == 1:\n        tw.vars.set('bomb_exploded', True)\n        tw.game.game_over('You cut the blue wire. The bomb exploded.')\n        return\n    if answ == 2:\n        tw.player.damage(5)\n        tw.narrate('You scream. The bomb does not care. Panic costs you precious seconds. (-5 HP)')\n        return\n    tw.narrate('You step back from the bomb. The ticking follows you through the room.')\n"
}