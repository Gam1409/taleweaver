      "id": "FRACTURE_LOG",
      "entity_type": "OBJECT",
      "name": "The Fracture Log",
      "description": "A crystalline tablet etched with shifting golden glyphs that record the final moments before the Fracture split the Construct's realities apart.",
      "appearance": "translucent crystal tablet, glowing golden glyphs, brass frame, ancient relic",
      "current_scene_id": "THE_CONSTRUCT",
      "spatial_position": "resting upon an obsidian lectern near the balustrade",
      "image_url": "assets/c9ecc947-de66-45c5-9c52-910c1056964a_fracture-log_7e5da6b1.jpg",
