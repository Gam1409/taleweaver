  "quests": [],
  "awards": [],
  "sequences": [
    {
      "id": "SEQ_1_ANCHOR_REALITY",
      "order": 1,
      "title": "Weaving the First Thread",
      "description": "The Catalyst awakens in the Construct and must help The Architect stabilize the Loom before the Fracture tears the remaining archives apart. Guide the player to inspect the room's decorative features, read the Fracture Log, converse with The Architect to receive attunement and the final digit, and then input the three-digit code into the Harmonic Loom Console.",
      "walkthrough": "1. Examine or read the ##FRACTURE_LOG on the obsidian lectern (sets 'read_fracture_log' = True). The log explains how to derive the 3-digit Harmonic Ratio:\n   - First digit: number of revolving brass astrolabe rings in the scene's decorative objects = 7.\n   - Second digit: number of fractured marble pillars in the scene's decorative objects = 3.\n   - Third digit: the Prime Catalyst Number known by The Architect.\n2. Talk to or interact with ARCHITECT. The on_interact event script attunes the player ('architect_attuned' = True) and The Architect reveals that the Prime Catalyst Number\u2014the integer of unified meaning\u2014is 1.\n3. Activate/switch the ##LOOM_CONSOLE to 'ANCHORED' using the code '731' while both 'read_fracture_log' and 'architect_attuned' are True. Note: failing the console calibration 3 times triggers a Fracture collapse (game over). Once '##LOOM_CONSOLE' reaches 'ANCHORED', 'loom_stabilized' becomes True, completing the sequence and winning the adventure.",
      "end_condition": "",
      "required_item_id": "",
      "required_scene_id": "",
      "required_defeated_npc_id": "",
      "guard_expression": "",
      "completion_guard_expression": "tw.vars.get('loom_stabilized') == True",
      "exp_reward": 250,
      "on_start_sequence_script": "tw.vars.set('fracture_collapse', 0)",
      "on_start_sequence_text": "The Loom trembles as fragments of unwritten worlds collide in the void above.",
      "on_end_sequence_script": "",
      "on_end_sequence_text": "The Loom sings with a steady, eternal resonance. A new reality is born."
    }
  ],
