  "scenes": [
    {
      "id": "THE_CONSTRUCT",
      "label": "The Construct \u2014 Heart of the Loom",
      "description": "A vast, weightless sanctum suspended in the gulf between finished stories and forgotten dreams. Seven colossal brass astrolabe rings revolve slowly around the central platform, weaving rivers of \u0437\u043e\u043b\u043e\u0442\u043e\u0439 and cerulean light into the Loom. Beyond the obsidian balustrade, fragments of unanchored worlds\u2014a spire of glass, a petrified forest leaf, a clockwork moon\u2014drift through the mist before dissolving into static. The air vibrates with the deep, resonant hum of waiting potential.",
      "image_url": "assets/c9ecc947-de66-45c5-9c52-910c1056964a_scene_62f93fca.jpg",
      "decorative_objects": [
        "seven revolving brass astrolabe rings",
        "three fractured marble pillars",
        "two floating hourglasses of silver sand",
        "obsidian balustrade overlooking the void",
        "streams of golden story-threads",
        "drifting shards of crystallized memory",
        "ethereal canopy of half-written constellations"
      ],
      "on_enter_scene_script": "tw.vars.set('visited_construct', True)",
      "on_enter_scene_text": "The Loom pulses with a low, harmonic chord as your presence registers within the Construct.",
      "on_leave_scene_script": null,
      "on_leave_scene_text": null
    }
  ],
  "exits": [],
  "npcs": [
    {
      "id": "ARCHITECT",
      "entity_type": "NPC",
      "name": "The Architect",
      "description": "An ancient, towering intelligence bound to the Loom. Its body is a seamless synthesis of articulated ivory plates, brass filigree, and shifting polyhedrons of warm amber light where a face should be. Every gesture it makes leaves faint trails of geometric notation in the air.",
      "appearance": "tall construct being, ivory armor plates, glowing geometric halo, brass robes, faceless mask",
      "current_scene_id": "THE_CONSTRUCT",
      "spatial_position": "standing beside the central rings of the Loom",
      "image_url": "assets/c9ecc947-de66-45c5-9c52-910c1056964a_architect_602ce8dd.jpg",
      "is_hidden": false,
      "npc_type": "BEING",
      "movement_type": "STATIONARY",
      "moveable": false,
      "allowed_scenes": [
        "THE_CONSTRUCT"
